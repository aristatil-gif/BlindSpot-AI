# Copy to .env and edit. BlindSpot AI runs without any of these (offline keyword engine).
PORT=3000
# Optional: enables AI-assisted aspect extraction. Keep this on the server only; never commit a real key.
ANTHROPIC_API_KEY=
# Optional model override for AI-assisted extraction.
BLINDSPOT_MODEL=claude-haiku-5-5
# Optional SQLite file location.
BLINDSPOT_DB=./data/blindspot.db
